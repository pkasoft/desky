# Desky Matchmaker & Commercial Web Server Configuration

# UDP Port for direct P2P rendezvous and zero-copy relaying
DESKY_PORT=21116

# HTTP Port for the Actix-Web + Askama Control Dashboard
DESKY_WEB_PORT=21117

# Commercial Admin Authentication Token / Password
# Set a strong secret token to protect the web dashboard and REST APIs.
# Access via: https://desky-admn.pkasoft.com/?token=YOUR_ADMIN_PASSWORD
DESKY_ADMIN_TOKEN=your_secure_admin_password_here

# SQLite Database Storage Path
DESKY_DB_PATH=desky.db
